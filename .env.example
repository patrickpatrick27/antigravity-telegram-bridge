# ==============================================================================
# Antigravity Telegram Bridge Configuration
# ==============================================================================

# Telegram Bot Credentials
# Obtain BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram numeric User ID (obtain via @userinfobot)
# The bot will reject messages from any other ID for strict security
ALLOWED_USER_ID=123456789

# Antigravity CLI & Workspace Settings
# Path to default workspace directory where agy will execute commands
DEFAULT_WORKSPACE=/home/user

# Default model to load on fresh startup
# Options: gemini-3.7-flash-medium, gemini-3.7-flash-high, claude-sonnet-4-6, claude-opus-4-6-thinking
DEFAULT_MODEL=gemini-3.7-flash-medium

# Path to the Antigravity binary
AGY_BIN=~/.local/bin/agy

# (Optional) Google CloudCode PA OAuth Credentials for /pin Quota Dashboard
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
